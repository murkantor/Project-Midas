# Assets - entirely derived/extracted from the copyrighted ROM (baserom.u.z64)
# via scripts/extract_baserom.u.sh + the Python model/asset generators, OR
# contain ROM data reconstructed byte-for-byte as C arrays (fonts, animation
# tables, the Rareware logo). NEVER commit ROM-derived content: regenerate
# locally instead (see docs/port/ and scripts/).
#
# Default-deny the whole tree, then explicitly allow-list only the
# hand-written build scaffolding (Makefile fragments - no ROM bytes) that
# `make` unconditionally `include`s and therefore must exist for ANY build
# (including CI, which starts from a clean checkout). Anything not
# explicitly allow-listed below stays ignored, so new files added under
# assets/ are excluded by default rather than accidentally committed.
/assets/*
!/assets/Makefile.music
!/assets/Makefile.obseg
!/assets/images.def
!/assets/image_externs.h
!/assets/romfiles2.s
!/assets/oddtextures.c
!/assets/oddtextures.h
!/assets/animationtable_data.c
!/assets/animationtable_data.h
!/assets/animationtable_entries.c
!/assets/animationtable_entries.h
!/assets/rarewarelogo.c
!/assets/font_dl.c
!/assets/font_dl.h
!/assets/font_chardatae.c
!/assets/font_chardataj.c
!/assets/font/
/assets/font/*
!/assets/font/fontBankGothic.c
!/assets/font/fontZurichBold.c
!/assets/embedded/
/assets/embedded/*
!/assets/embedded/skeletons/
/assets/embedded/skeletons/*
!/assets/embedded/skeletons/*.inc.c
!/assets/embedded/player_gait_object/
/assets/embedded/player_gait_object/*
!/assets/embedded/player_gait_object/*.inc.c
!/assets/obseg/
/assets/obseg/*
!/assets/obseg/Makefile.filelist
!/assets/obseg/Makefile.bg
!/assets/obseg/Makefile.chr
!/assets/obseg/Makefile.gun
!/assets/obseg/Makefile.prop
!/assets/obseg/Makefile.stan
!/assets/obseg/Makefile.brief
!/assets/obseg/Makefile.setup
!/assets/obseg/Makefile.text
!/assets/obseg/obseg.h
!/assets/obseg/file_resource_id_enums.h
!/assets/obseg/file_resource_table.inc.c

# gun/chr/prop: each item's directory holds hand-authored reverse-engineered
# METADATA (file header macros, weapon stat structs, position offsets, and
# string references BY SYMBOLIC ID like getStringID(LGUN, GUN_STR_83_LF) -
# no literal copyrighted text/geometry/pixels) ALONGSIDE Model.c (the actual
# ROM-derived model geometry/texture data - stays denied, never commit).
# generate_{gun,chr,prop}_model_c.py requires the item directory to already
# exist or it skips the item entirely ("Missing metadata directory").
!/assets/obseg/gun/
/assets/obseg/gun/*
!/assets/obseg/gun/gunModelFileHeaders.inc.c
!/assets/obseg/gun/gunModelFileRecord.inc.c
!/assets/obseg/gun/gunWeaponStats.inc.c
!/assets/obseg/gun/*/
/assets/obseg/gun/*/*
!/assets/obseg/gun/*/ModelFileHeader.inc.c
!/assets/obseg/gun/*/gunFileRecord.inc.c
!/assets/obseg/gun/*/gunWeaponStat.inc.c

!/assets/obseg/chr/
/assets/obseg/chr/*
!/assets/obseg/chr/chrModelFileHeaders.inc.c
!/assets/obseg/chr/chrModelFileRecords.inc.c
!/assets/obseg/chr/chrHeadHats.inc.c
!/assets/obseg/chr/*/
/assets/obseg/chr/*/*
!/assets/obseg/chr/*/modelFileHeader.inc.c
!/assets/obseg/chr/*/chrModelFileRecord.inc.c

!/assets/obseg/prop/
/assets/obseg/prop/*
!/assets/obseg/prop/propModelFileHeaders.inc.c
!/assets/obseg/prop/propItemModelFileRecord.inc.c
!/assets/obseg/prop/propExplosionDetailsRecords.inc.c
!/assets/obseg/prop/propExplosionDetailsRecords-eu.inc.c
!/assets/obseg/prop/*/
/assets/obseg/prop/*/*
!/assets/obseg/prop/*/ModelFileHeader.inc.c
!/assets/obseg/prop/*/propFileRecord.inc.c

# bg/brief/setup/stan: reconstructed level geometry/collision/mission-briefing
# C source (structs, not raw ROM bytes) - required directly by the CMake
# asset manifest (port/generated/asset_manifest.cmake) or transitively via
# #include. Raw .bin extraction artifacts stay denied below.
!/assets/obseg/bg/
/assets/obseg/bg/*
!/assets/obseg/bg/*.c
!/assets/obseg/bg/*.h
!/assets/obseg/bg/*.ld
!/assets/obseg/bg/u/
/assets/obseg/bg/u/*
!/assets/obseg/bg/u/*.c
!/assets/obseg/bg/u/*.h

!/assets/obseg/brief/
/assets/obseg/brief/*
!/assets/obseg/brief/*.c
!/assets/obseg/brief/Ubrief.h

!/assets/obseg/setup/
/assets/obseg/setup/*
!/assets/obseg/setup/*.c
!/assets/obseg/setup/stagesetup.h
!/assets/obseg/setup/u/
/assets/obseg/setup/u/*
!/assets/obseg/setup/u/*.c

!/assets/obseg/stan/
/assets/obseg/stan/*
!/assets/obseg/stan/*.c

# text: base (US) game dialogue/UI text source, plus the u/ subfolder which
# (despite the name) holds Japanese-text variants embedded in the US ROM
# that the US build requires (e.g. LarecJ.c). True EU/JP region builds
# (e/, j/) are unused here and stay denied.
!/assets/obseg/text/
/assets/obseg/text/*
!/assets/obseg/text/*.c
!/assets/obseg/text/*.h
!/assets/obseg/text/u/
/assets/obseg/text/u/*
!/assets/obseg/text/u/*.c

